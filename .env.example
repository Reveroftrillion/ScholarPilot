AI_MODE=live
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TOOL_FORMAT=json
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1000
OLLAMA_NUM_BATCH=128
OLLAMA_TIMEOUT=600
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
MAX_AGENT_STEPS=12
# Explicit opt-in: selected text, retrieved passages and questions go to OpenAI.
ALLOW_EXTERNAL_AI=false
DATA_DIR=data
MAX_UPLOAD_MB=100
